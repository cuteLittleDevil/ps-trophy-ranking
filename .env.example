# PSN Trophy Leaderboard Configuration
# Copy to .env and fill in your values (never commit .env)

# Sony NPSSO cookie for real PSN access (required for /join endpoint)
# Get from: https://ca.account.sony.com/api/v1/ssocookie after logging in
PSN_NPSSO=

# SQLite database file path
DB_PATH=./data/leaderboard.db

# HTTP server listen address (default: 127.0.0.1:8080)
# WARNING: /admin/seed endpoint has no authentication.
# Only bind to localhost unless you implement additional security measures.
LISTEN_ADDR=127.0.0.1:8080
